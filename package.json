{
  "name": "elven-unified-observability-react-native",
  "version": "0.2.0",
  "type": "module",
  "description": "Production-grade unified observability for React Native",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "elven-unified-observability-react-native-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "MIGRATION.md",
    "PERFORMANCE.md",
    "README.md",
    "RELEASING.md",
    "SECURITY.md",
    "VALIDATION.md",
    "docs",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace elven-unified-observability-react-native-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "build": "bob build",
    "format:check": "prettier --check \"*.{md,json,mjs}\" \"docs/**/*.md\" \"example/**/*.{js,md,json,yml,yaml,ts,tsx}\" \"scripts/**/*.{js,mjs,ts,tsx}\" \"src/**/*.{ts,tsx}\" \".github/**/*.{yml,yaml,json}\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 \"{src,example/src,scripts}/**/*.{js,mjs,ts,tsx}\"",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "native:codegen": "node node_modules/react-native/scripts/generate-codegen-artifacts.js -p . -t all -s library -o artifacts/codegen",
    "security:audit": "yarn npm audit --all --recursive --severity high",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "package:lint": "publint --pack npm --strict && attw --pack --profile esm-only .",
    "pack:check": "npm pack --dry-run",
    "release:check": "node scripts/verify-release.mjs",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn test:coverage && yarn build && yarn native:codegen && yarn security:audit && yarn benchmark && yarn size && yarn package:lint && yarn pack:check",
    "prepublishOnly": "node .yarn/releases/yarn-4.11.0.cjs validate"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "opentelemetry",
    "observability",
    "logs",
    "metrics",
    "tracing",
    "expo",
    "hermes",
    "turbo-module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leozw/elven-unified-observability-react-native.git"
  },
  "author": "Leonardo Zwirtes <lzwdeveloper@gmail.com> (https://github.com/leozw)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/leozw/elven-unified-observability-react-native/issues"
  },
  "homepage": "https://github.com/leozw/elven-unified-observability-react-native#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "7.29.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "9.39.5",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "babel-jest": "29.7.0",
    "del-cli": "^7.0.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "hermes-eslint": "0.37.0",
    "jest": "29.7.0",
    "prettier": "^3.8.3",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "19.2.3",
    "test-renderer": "1.2.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-native": ">=0.79.7 <0.80.0 || >=0.86.0 <0.88.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "sideEffects": false,
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "eslint-plugin-ft-flow@npm:^2.0.1": "npm:3.0.11",
    "image-size@npm:^1.0.2": "npm:image-size-next@1.2.2"
  },
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ElvenUnifiedObservabilityReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.elvenunifiedobservabilityreactnative"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@noble/hashes)/)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/example/",
      "/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/Native*.ts",
      "!src/index.ts",
      "!src/**/__fixtures__/**",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 85,
        "statements": 85
      }
    }
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/otlp-transformer": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0"
  }
}
