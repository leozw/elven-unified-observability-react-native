{
  "name": "elven-unified-observability-react-native-example",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "expo": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "cross-env NODE_ENV=production xcodebuild ONLY_ACTIVE_ARCH=YES CODE_SIGNING_ALLOWED=NO -workspace ios/ElvenUnifiedObservabilityReactNativeExample.xcworkspace -UseNewBuildSystem=YES -scheme ElvenUnifiedObservabilityReactNativeExample -configuration Release -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cross-env NODE_ENV=production ./android/gradlew -p android assembleRelease -Dorg.gradle.jvmargs=-Xmx4g",
    "build:web": "expo export --platform web"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "10.1.0",
    "expo-dev-client": "~57.0.14",
    "react-native-builder-bob": "^0.43.0",
    "react-native-monorepo-config": "^0.4.0"
  }
}
