{
  "expo": {
    "name": "ElvenUnifiedObservabilityReactNative Example",
    "slug": "elven-unified-observability-react-native-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "elvenunifiedobservabilityreactnative.example",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "elvenunifiedobservabilityreactnative.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["./plugins/with-local-collector-network-security"]
  }
}
